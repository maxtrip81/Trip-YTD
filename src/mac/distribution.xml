<?xml version="1.0" encoding="utf-8"?>
<!-- Installer di Trip YTD per macOS: build.sh sostituisce @VERSION@ e lo passa a productbuild. -->
<installer-gui-script minSpecVersion="2">
    <title>Trip YTD @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_currentUserHome="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="com.trip.ytd"/>
    </choices-outline>
    <choice id="com.trip.ytd" title="Trip YTD">
        <pkg-ref id="com.trip.ytd"/>
    </choice>
    <pkg-ref id="com.trip.ytd" version="@VERSION@">TripYTD.pkg</pkg-ref>
</installer-gui-script>
